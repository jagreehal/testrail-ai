# Your TestRail instance, with no trailing slash.
TESTRAIL_URL=https://your-instance.testrail.io

# The email you log in with. TESTRAIL_USERNAME also works, for compatibility
# with the older community servers.
TESTRAIL_EMAIL=you@example.com

# NOT your password. Generate one in TestRail under My Settings › API Keys.
# The API must also be enabled instance-wide: Administration › Site Settings › API.
TESTRAIL_API_KEY=

# Writes are off unless this is exactly "true". With it unset everything is
# readable and nothing is changeable, which is the right default for a shared
# QA instance — a model cannot post a result or close a run by mistake.
TESTRAIL_ALLOW_WRITES=false

# Optional. The project to use when a tool call or CLI command leaves the
# project out. Tools still accept any other project explicitly.
# TESTRAIL_PROJECT_ID=5

# Optional. Cap on rows any one call will pull back.
TESTRAIL_MAX_ROWS=250

# Optional. Per-request timeout in milliseconds.
TESTRAIL_TIMEOUT_MS=30000

# Optional on enterprise networks. Node 24 can use HTTP_PROXY, HTTPS_PROXY and
# NO_PROXY for native fetch when this is enabled.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example

# Optional. PEM bundle for a private certificate authority. TLS verification
# remains enabled; there is intentionally no insecure mode.
# NODE_EXTRA_CA_CERTS=/run/secrets/company-ca.pem

# Optional. Set this and the MCP server traces itself via autotel.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
