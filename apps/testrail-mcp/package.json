{
  "name": "testrail-ai-mcp",
  "version": "0.3.0",
  "description": "MCP server for TestRail — ten task-oriented tools, resources and prompts, on specification 2026-07-28",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/testrail-ai"
  },
  "homepage": "https://github.com/jagreehal/testrail-ai#readme",
  "bugs": {
    "url": "https://github.com/jagreehal/testrail-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "testrail-ai-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/stdio.ts",
    "dev:http": "tsx watch src/http.ts",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "vitest run --coverage && prettier --write docs/stories.md",
    "test:watch": "vitest",
    "test:smoke": "tsx src/smoke.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:smoke:write": "tsx src/smoke-write.ts"
  },
  "keywords": [
    "testrail",
    "mcp",
    "model-context-protocol",
    "qa",
    "ai-agents"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "MIT",
  "dependencies": {
    "testrail-ai": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "autotel": "^7.9.0",
    "autotel-mcp-instrumentation": "^59.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "executable-stories-vitest": "8.10.1",
    "mcp-authz": "0.2.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
